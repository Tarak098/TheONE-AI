# ==============================================================================
# TheONE AI - Example Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply your credentials:
#   cp .env.example .env
# ==============================================================================

# Application Server Settings
APP_NAME=TheONE AI
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Shared Gnani API Key
GNANI_API_KEY=your_gnani_api_key_here

# LLM Intelligence Engine Provider Selection ('gemini' or 'evon')
LLM_PROVIDER=gemini

# Google Gemini / Gemma API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=60

# Gnani Prisma (Speech-to-Text / ASR) Configuration
GNANI_PRISMA_API_KEY=your_gnani_prisma_api_key_here
GNANI_PRISMA_API_URL=https://api.vachana.ai/stt/v3
GNANI_PRISMA_VERSION=v3
GNANI_PRISMA_TIMEOUT=60

# Gnani Evon (AI Response Generation / LLM)
GNANI_EVON_ENABLED=False
GNANI_EVON_API_KEY=your_gnani_evon_api_key_here
GNANI_EVON_API_URL=https://api.gnani.ai/evon/v1

# Gnani Timbre (Text-to-Speech / TTS) Configuration
GNANI_TIMBRE_API_KEY=your_gnani_timbre_api_key_here
GNANI_TIMBRE_API_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-2.5
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_VOICE=Zayan
GNANI_TTS_VOICE_FUNNY=Yashvi
GNANI_TTS_VOICE_ROAST=Zayan
GNANI_TTS_SAMPLE_RATE=48000
